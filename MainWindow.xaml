<Window x:Class="SistemaExpertoPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SistemaExpertoPC.ViewModels"
        Title="Sistema Experto de Diagnóstico de PC"
        Width="1020" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="14">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="AzulBrush" Color="#1E5AA8" />
        <SolidColorBrush x:Key="AzulOscuroBrush" Color="#153E75" />
        <SolidColorBrush x:Key="AzulClaroBrush" Color="#E8F0FB" />
        <SolidColorBrush x:Key="GrisBrush" Color="#6B7785" />
        <SolidColorBrush x:Key="GrisTextoBrush" Color="#3A4452" />
        <SolidColorBrush x:Key="BordeBrush" Color="#D0D7E2" />

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource AzulBrush}" />
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource GrisBrush}" />
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AzulOscuroBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="TextoNormal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GrisTextoBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AzulBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Sistema Experto de Diagnóstico de PC"
                           Foreground="White" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Seleccione los síntomas que presenta su computadora para obtener un diagnóstico orientativo."
                           Foreground="#DCE8F8" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Síntomas"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AzulOscuroBrush}" Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sintomas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                              Margin="0,6" VerticalContentAlignment="Top">
                                        <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource GrisTextoBrush}" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <UniformGrid Grid.Row="2" Rows="1" Margin="0,14,0,0">
                        <Button Content="Analizar síntomas" Command="{Binding AnalizarCommand}"
                                Style="{StaticResource BotonPrimario}" Margin="0,0,5,0" />
                        <Button Content="Limpiar selección" Command="{Binding LimpiarCommand}"
                                Style="{StaticResource BotonSecundario}" Margin="5,0,0,0" />
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Resultados del análisis"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AzulOscuroBrush}" Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <Border Background="{StaticResource AzulClaroBrush}"
                                    BorderBrush="{StaticResource AzulBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="14"
                                    Visibility="{Binding MostrarMensaje, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Mensaje}" Style="{StaticResource TextoNormal}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Diagnosticos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFD" BorderBrush="{StaticResource BordeBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Problema}" FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource AzulBrush}" TextWrapping="Wrap" />

                                                <TextBlock Text="Explicación" Style="{StaticResource Subtitulo}" />
                                                <TextBlock Text="{Binding Explicacion}" Style="{StaticResource TextoNormal}" />

                                                <TextBlock Text="Recomendaciones" Style="{StaticResource Subtitulo}" />
                                                <ItemsControl ItemsSource="{Binding Recomendaciones}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='• {0}'}"
                                                                       Style="{StaticResource TextoNormal}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Reglas aplicadas" Style="{StaticResource Subtitulo}" />
                                                <ItemsControl ItemsSource="{Binding ReglasActivadas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='• {0}'}"
                                                                       Foreground="{StaticResource GrisBrush}"
                                                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E4E8EE" Padding="20,8">
            <TextBlock Style="{StaticResource TextoNormal}" FontSize="12"
                       Text="Los diagnósticos son orientativos y no confirman una falla física. Ante cualquier duda, consulte a un técnico." />
        </Border>
    </Grid>
</Window>
